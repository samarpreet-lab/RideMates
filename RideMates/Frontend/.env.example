# =============================================================================
# RideMates Frontend Environment Variables
# =============================================================================
# Copy this file to .env and .env.production, then update with your values.
# NEVER commit actual keys/secrets to version control!
# 
# Note: All variables must be prefixed with EXPO_PUBLIC_ to be accessible
# in the React Native app (Expo requirement).
# =============================================================================

# API Configuration
# Development: Point to local backend (use your machine's IP address)
# Production: Point to Render backend
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.9:5000/api

# Email Domain Restriction
# Only @lpu.in emails allowed for signup
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=lpu.in

# LocationIQ API Key
# Get from: https://locationiq.com
# For location search autocomplete functionality
EXPO_PUBLIC_LOCATIONIQ_API_KEY=pk.af5de466389a1393d420514979c66614

# Firebase Configuration
# Get these from Firebase Console → Project Settings → Your Apps
# https://console.firebase.google.com
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ridemates-mobile.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ridemates-mobile
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ridemates-mobile.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Environment
NODE_ENV=development
