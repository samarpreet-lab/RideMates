# =============================================================================
# RideMates Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control!
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL/Aiven)
DB_HOST=mysql-35f2a6a0-bhamrasamar01.j.aivencloud.com
DB_PORT=26669
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password-here
DB_NAME=defaultdb
DB_SSL=true

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-64-byte-hex-secret-here-generate-new-for-production
JWT_EXPIRES_IN=7d

# SMTP Configuration (Gmail with App Passwords)
# 1. Go to myaccount.google.com → Security → 2-Step Verification
# 2. Generate a new app password for "Mail"
# 3. Paste the 16-character password below (no spaces)
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=RideMates <your-email@gmail.com>

# CORS Configuration (comma-separated list of allowed origins)
# Development: Allow localhost and local network
# Production: Only allow your Render domain
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,https://ridemates.onrender.com

# App URL (Base URL for redirects, CSRF protection)
# Used in emails, password resets, and security headers
APP_URL=https://ridemates.onrender.com
