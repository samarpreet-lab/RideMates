# ===================================
# RideMates .gitignore
# ===================================

# Environment Variables (SECRETS - NEVER COMMIT)
.env
.env.local
.env.*.local

# Node.js
node_modules/
npm-debug.log
npm-debug.log.*
yarn-error.log
package-lock.json
yarn.lock

# Expo
.expo
.expo-shared/
dist/

# IDE & Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store

# Build outputs
build/
dist/
*.apk
*.aab
*.ipa

# OS
.DS_Store
Thumbs.db
*.log

# Database backups (if any)
*.sql.bak
*.backup

# Temporary files
tmp/
temp/
*.tmp

# macOS
.AppleDouble
.AppleDB
*.dSYM/

# Firebase
.firebase/
firebase-debug.log

# Testing
coverage/
.nyc_output/

# Misc
.cache/
.parcel-cache/
RideMates/Frontend
